generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "mysql"
}

model Branch {
  id            String         @id @default(uuid())
  code          String         @unique
  name          String
  type          BranchType
  isActive      Boolean        @default(true)
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  displayName   String
  users         User[]
  dailyRequests DailyRequest[] @relation("BranchRequest")

  stockReceipts  StockReceipt[]
  stockBalances  BranchStockBalance[]
  stockMovements StockMovement[]

  stockCounts StockCount[]

  @@map("branches")
}

model Role {
  id          String   @id @default(uuid())
  code        String   @unique
  name        String
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  displayName String
  users       User[]

  @@map("roles")
}

model User {
  trackingNumber   Int               @unique @default(autoincrement())
  id               String            @id @default(uuid())
  username         String            @unique
  passwordHash     String
  firstName        String
  lastName         String
  isActive         Boolean           @default(true)
  branchId         String
  roleId           String
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  assignedRequests DailyRequest[]    @relation("AssignedTo")
  createdRequests  DailyRequest[]    @relation("CreatedBy")
  deletedRequests  DailyRequest[]    @relation("DeletedBy")
  branch           Branch            @relation(fields: [branchId], references: [id])
  role             Role              @relation(fields: [roleId], references: [id])
  workflowHistory  WorkflowHistory[]

  stockReceiptsCreated   StockReceipt[]  @relation("StockReceiptCreator")
  stockReceiptsConfirmed StockReceipt[]  @relation("StockReceiptConfirmer")
  stockReceiptsReversed  StockReceipt[]  @relation("StockReceiptReverser")
  stockMovements         StockMovement[] @relation("StockMovementActor")

  stockCountsCreated  StockCount[]      @relation("StockCountCreator")
  stockCountsApproved StockCount[]      @relation("StockCountApprover")
  stockCountEvents    StockCountEvent[] @relation("StockCountActor")

  productImagesEdited ProductImage[] @relation("ProductImageEditor")
  catalogEvents       CatalogEvent[] @relation("CatalogEventActor")

  @@index([branchId])
  @@index([roleId])
  @@map("users")
}

model ProductCategory {
  id           String    @id @default(uuid())
  code         String    @unique
  name         String
  description  String?
  isActive     Boolean   @default(true)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  displayOrder Int       @default(0)
  displayName  String
  products     Product[]

  catalogEvents CatalogEvent[]

  @@map("product_categories")
}

model Product {
  id                String             @id @default(uuid())
  code              String             @unique
  name              String
  categoryId        String
  unit              Unit
  isActive          Boolean            @default(true)
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  displayName       String
  barcode           String?            @unique
  notes             String?
  productionOrder   Int                @default(0)
  sortOrder         Int                @default(0)
  dailyRequestLines DailyRequestLine[]
  category          ProductCategory    @relation(fields: [categoryId], references: [id])

  stockReceiptLines StockReceiptLine[]
  stockBalances     BranchStockBalance[]
  stockMovements    StockMovement[]

  stockCountLines StockCountLine[]

  catalogVersion Int            @default(1)
  image          ProductImage?
  catalogEvents  CatalogEvent[]

  @@index([categoryId])
  @@map("products")
}

model DailyRequest {
  trackingNumber Int                @unique @default(autoincrement())
  id             String             @id @default(uuid())
  businessDate   DateTime
  status         RequestStatus      @default(DRAFT)
  branchId       String
  createdById    String
  submittedAt    DateTime?
  approvedAt     DateTime?
  completedAt    DateTime?
  reportedAt     DateTime?
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt
  assignedToId   String?
  lastActionAt   DateTime?
  deletedAt      DateTime?
  deletedById    String?
  cancelledAt    DateTime?
  lines          DailyRequestLine[]
  assignedTo     User?              @relation("AssignedTo", fields: [assignedToId], references: [id])
  createdBy      User               @relation("CreatedBy", fields: [createdById], references: [id])
  deletedBy      User?              @relation("DeletedBy", fields: [deletedById], references: [id])
  branch         Branch?            @relation("BranchRequest", fields: [branchId], references: [id])
  history        WorkflowHistory[]
  editLease      RequestEditLease?

  stockReceipt StockReceipt? @relation("RequestStockReceipt")

  @@index([branchId, businessDate])
  @@index([status])
  @@index([businessDate])
  @@index([assignedToId], map: "daily_requests_assignedToId_fkey")
  @@index([createdById], map: "daily_requests_createdById_fkey")
  @@index([deletedById], map: "daily_requests_deletedById_fkey")
  @@map("daily_requests")
}

model RequestEditLease {
  dailyRequestId String       @id
  ownerId        String
  token          String       @unique
  expiresAt      DateTime
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  dailyRequest   DailyRequest @relation(fields: [dailyRequestId], references: [id], onDelete: Cascade)

  @@index([expiresAt])
  @@map("request_edit_lease")
}

model DailyRequestLine {
  id              String       @id @default(uuid())
  dailyRequestId  String
  productId       String
  previousBalance Int
  currentBalance  Int
  reportTime      DateTime?
  requestedQty    Int?
  producedQty     Int?
  receivedQty     Int?
  managerNote     String?
  workshopNote    String?
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt
  dailyRequest    DailyRequest @relation(fields: [dailyRequestId], references: [id])
  product         Product      @relation(fields: [productId], references: [id])

  @@unique([dailyRequestId, productId])
  @@index([productId])
  @@map("daily_request_lines")
}

model WorkflowHistory {
  id             String         @id @default(uuid())
  dailyRequestId String
  userId         String
  fromStatus     RequestStatus?
  toStatus       RequestStatus
  note           String?
  action         String
  changedAt      DateTime       @default(now())
  dailyRequest   DailyRequest   @relation(fields: [dailyRequestId], references: [id])
  user           User           @relation(fields: [userId], references: [id])

  @@index([dailyRequestId])
  @@index([userId])
  @@map("workflow_history")
}

enum BranchType {
  SALES
  BAKERY
}

enum RequestStatus {
  DRAFT
  INVENTORY_SUBMITTED
  MANAGER_SUBMITTED
  WORKSHOP_PROCESSING
  COMPLETED
  CLOSED
  CANCELLED
}

enum Unit {
  PCS
  KG
  GR
  LITER
  BOX
}

enum StockReceiptStatus {
  DRAFT
  CONFIRMED
  REVERSED
}

enum StockMovementKind {
  RECEIPT
  RECEIPT_REVERSAL
  OPENING_BALANCE
  COUNT_ADJUSTMENT
}

model StockReceipt {
  trackingNumber  Int                @unique @default(autoincrement())
  id              String             @id @default(uuid())
  clientRequestId String             @unique
  createHash      String             @db.Char(64)
  branchId        String
  businessDate    DateTime
  sourceType      String             @default("MANUAL_RECEIPT")
  status          StockReceiptStatus @default(DRAFT)
  version         Int                @default(1)
  note            String?            @db.Text
  createdById     String
  confirmedById   String?
  reversedById    String?
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt
  confirmedAt     DateTime?
  reversedAt      DateTime?
  reversalReason  String?            @db.Text
  branch          Branch             @relation(fields: [branchId], references: [id])
  createdBy       User               @relation("StockReceiptCreator", fields: [createdById], references: [id])
  confirmedBy     User?              @relation("StockReceiptConfirmer", fields: [confirmedById], references: [id])
  reversedBy      User?              @relation("StockReceiptReverser", fields: [reversedById], references: [id])
  lines           StockReceiptLine[]
  movements       StockMovement[]

  sourceRequestId String?       @unique
  sourceRequest   DailyRequest? @relation("RequestStockReceipt", fields: [sourceRequestId], references: [id], onDelete: Restrict)

  @@index([branchId, businessDate])
  @@index([createdById])
  @@index([confirmedById])
  @@index([reversedById])
  @@map("stock_receipts")
}

model StockReceiptLine {
  id        String       @id @default(uuid())
  receiptId String
  productId String
  quantity  Decimal      @db.Decimal(18, 3)
  receipt   StockReceipt @relation(fields: [receiptId], references: [id], onDelete: Cascade)
  product   Product      @relation(fields: [productId], references: [id])

  @@unique([receiptId, productId])
  @@index([productId])
  @@map("stock_receipt_lines")
}

model BranchStockBalance {
  branchId  String
  productId String
  quantity  Decimal  @default(0) @db.Decimal(18, 3)
  updatedAt DateTime @updatedAt
  branch    Branch   @relation(fields: [branchId], references: [id])
  product   Product  @relation(fields: [productId], references: [id])

  revision Int @default(0)

  @@id([branchId, productId])
  @@index([productId])
  @@map("branch_stock_balances")
}

model StockMovement {
  id                 String            @id @default(uuid())
  branchId           String
  productId          String
  receiptId          String?
  sourceKey          String            @unique
  kind               StockMovementKind
  quantityDelta      Decimal           @db.Decimal(18, 3)
  businessDate       DateTime
  actorId            String
  postedAt           DateTime          @default(now())
  reason             String?           @db.Text
  originalMovementId String?           @unique
  branch             Branch            @relation(fields: [branchId], references: [id])
  product            Product           @relation(fields: [productId], references: [id])
  receipt            StockReceipt?     @relation(fields: [receiptId], references: [id], onDelete: Restrict)
  actor              User              @relation("StockMovementActor", fields: [actorId], references: [id])
  originalMovement   StockMovement?    @relation("StockMovementReversal", fields: [originalMovementId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  reversal           StockMovement?    @relation("StockMovementReversal")

  countId    String?
  stockCount StockCount? @relation(fields: [countId], references: [id], onDelete: Restrict)

  @@index([branchId, productId, postedAt])
  @@index([productId])
  @@index([receiptId])
  @@index([actorId])
  @@index([countId])
  @@map("stock_movements")
}

enum StockCountKind {
  OPENING
  COUNT
}

enum StockCountStatus {
  DRAFT
  SUBMITTED
  APPROVED
}

model StockCount {
  trackingNumber  Int               @unique @default(autoincrement())
  id              String            @id @default(uuid())
  clientRequestId String            @unique
  branchId        String
  kind            StockCountKind
  status          StockCountStatus  @default(DRAFT)
  businessDate    DateTime
  version         Int               @default(1)
  note            String?           @db.Text
  approvalReason  String?           @db.Text
  createdById     String
  approvedById    String?
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt
  submittedAt     DateTime?
  approvedAt      DateTime?
  branch          Branch            @relation(fields: [branchId], references: [id])
  createdBy       User              @relation("StockCountCreator", fields: [createdById], references: [id])
  approvedBy      User?             @relation("StockCountApprover", fields: [approvedById], references: [id])
  lines           StockCountLine[]
  events          StockCountEvent[]
  movements       StockMovement[]

  @@index([branchId, createdAt])
  @@index([createdById])
  @@index([approvedById])
  @@map("stock_counts")
}

model StockCountLine {
  id               String     @id @default(uuid())
  countId          String
  productId        String
  expectedQuantity Decimal    @db.Decimal(18, 3)
  countedQuantity  Decimal?   @db.Decimal(18, 3)
  snapshotRevision Int
  count            StockCount @relation(fields: [countId], references: [id], onDelete: Cascade)
  product          Product    @relation(fields: [productId], references: [id])

  @@unique([countId, productId])
  @@index([productId])
  @@map("stock_count_lines")
}

model StockCountEvent {
  id        String     @id @default(uuid())
  countId   String
  actorId   String
  action    String
  note      String?    @db.Text
  version   Int
  createdAt DateTime   @default(now())
  count     StockCount @relation(fields: [countId], references: [id])
  actor     User       @relation("StockCountActor", fields: [actorId], references: [id])

  @@index([countId, createdAt])
  @@index([actorId])
  @@map("stock_count_events")
}

model ProductImage {
  productId   String   @id
  data        Bytes    @db.MediumBlob
  mime        String   @db.VarChar(32)
  updatedById String
  updatedAt   DateTime @updatedAt
  product     Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  updatedBy   User     @relation("ProductImageEditor", fields: [updatedById], references: [id])

  @@index([updatedById])
  @@map("product_images")
}

model CatalogEvent {
  id         String           @id @default(uuid())
  productId  String?
  categoryId String?
  actorId    String
  action     String
  message    String           @db.Text
  payload    Json
  createdAt  DateTime         @default(now())
  product    Product?         @relation(fields: [productId], references: [id], onDelete: Restrict)
  category   ProductCategory? @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  actor      User             @relation("CatalogEventActor", fields: [actorId], references: [id])

  @@index([productId, createdAt])
  @@index([categoryId])
  @@index([actorId])
  @@map("catalog_events")
}
