enum StockCountKind {
  OPENING
  COUNT
}

enum StockCountStatus {
  DRAFT
  SUBMITTED
  APPROVED
}

model StockCount {
  id String @id @default(uuid())
  clientRequestId String @unique
  branchId String
  kind StockCountKind
  status StockCountStatus @default(DRAFT)
  businessDate DateTime
  version Int @default(1)
  note String? @db.Text
  approvalReason String? @db.Text
  createdById String
  approvedById String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  submittedAt DateTime?
  approvedAt DateTime?
  branch Branch @relation(fields: [branchId], references: [id])
  createdBy User @relation("StockCountCreator", fields: [createdById], references: [id])
  approvedBy User? @relation("StockCountApprover", fields: [approvedById], references: [id])
  lines StockCountLine[]
  events StockCountEvent[]
  movements StockMovement[]
  @@index([branchId, createdAt])
  @@index([createdById])
  @@index([approvedById])
  @@map("stock_counts")
}

model StockCountLine {
  id String @id @default(uuid())
  countId String
  productId String
  expectedQuantity Decimal @db.Decimal(18, 3)
  countedQuantity Decimal? @db.Decimal(18, 3)
  snapshotRevision Int
  count StockCount @relation(fields: [countId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id])
  @@unique([countId, productId])
  @@index([productId])
  @@map("stock_count_lines")
}

model StockCountEvent {
  id String @id @default(uuid())
  countId String
  actorId String
  action String
  note String? @db.Text
  version Int
  createdAt DateTime @default(now())
  count StockCount @relation(fields: [countId], references: [id])
  actor User @relation("StockCountActor", fields: [actorId], references: [id])
  @@index([countId, createdAt])
  @@index([actorId])
  @@map("stock_count_events")
}
