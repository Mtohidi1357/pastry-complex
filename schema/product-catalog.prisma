model ProductImage {
  productId String @id
  data Bytes @db.MediumBlob
  mime String @db.VarChar(32)
  updatedById String
  updatedAt DateTime @updatedAt
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  updatedBy User @relation("ProductImageEditor", fields: [updatedById], references: [id])
  @@index([updatedById])
  @@map("product_images")
}

model CatalogEvent {
  id String @id @default(uuid())
  productId String?
  categoryId String?
  actorId String
  action String
  message String @db.Text
  payload Json
  createdAt DateTime @default(now())
  product Product? @relation(fields: [productId], references: [id], onDelete: Restrict)
  category ProductCategory? @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  actor User @relation("CatalogEventActor", fields: [actorId], references: [id])
  @@index([productId, createdAt])
  @@index([categoryId])
  @@index([actorId])
  @@map("catalog_events")
}
